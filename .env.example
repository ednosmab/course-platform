# =====================================================
# SUPABASE CONFIGURATION
# =====================================================
# Copie este ficheiro para .env.local (admin) e .env (student)
# NUNCA commite ficheiros .env com valores reais

# URL do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://limqrpxdzxejvuqjiwpn.supabase.co
EXPO_PUBLIC_SUPABASE_URL=https://limqrpxdzxejvuqjiwpn.supabase.co

# Anon Key (pública, segura para client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# =====================================================
# SERVICE ROLE (APENAS SERVER-SIDE)
# =====================================================
# NUNCA exponha esta chave em código client-side
# Usar em: API routes, Server Actions, scripts de seed
SUPABASE_SERVICE_ROLE_KEY=

# =====================================================
# APP URLs
# =====================================================
NEXT_PUBLIC_STUDENT_APP_URL=http://localhost:8081
EXPO_PUBLIC_ADMIN_APP_URL=http://localhost:3000
