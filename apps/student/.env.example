# ============================================================================
# Student App Environment Variables (Expo)
# ============================================================================
# Copy this file to `.env` and fill in the real values for your environment.
# Variables prefixed with `EXPO_PUBLIC_` are inlined into the JS bundle at
# build time and are therefore safe to use in client code (see Expo docs).
# Do NOT commit a populated `.env` — only `.env.example` is tracked in git.

# --- Supabase (mandatory) ---
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- Cross-app links ---
EXPO_PUBLIC_ADMIN_APP_URL=http://localhost:3000

# --- Certificate actions (see apps/student/src/services/certificate-actions.ts) ---
# Base URL for the certificate PDF endpoint. The exact endpoint is open:
# could be a Next.js API route, a Supabase Edge Function, or a pre-rendered
# Storage URL. Tracked in BACKLOG with label `needs-spec`.
# Placeholder: a generic, non-affiliated domain (CONFID-01 compliant).
EXPO_PUBLIC_PDF_BASE_URL=https://api.example.com

# Base URL of the official extranet validation page. The `uuid_extranet` is
# appended to this URL when the user taps the "ExternalLink" action on a
# certificate card. No real partner domain in this file (CONFID-01).
EXPO_PUBLIC_EXTRANET_VALIDATION_URL=https://validacao.example.com
