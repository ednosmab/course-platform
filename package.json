{
  "name": "plataforma-cursos-cms",
  "version": "1.0.0",
  "scripts": {
    "build:verify": "pnpm --filter student run build:web && pnpm --filter admin run build",
    "test": "pnpm -r --if-present run test",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:vrt:ladle": "playwright test --config playwright.ladle.config.ts",
    "test:vrt": "playwright test --config playwright.ladle.config.ts",
    "test:react-consistency": "bash scripts/check-react-consistency.sh",
    "test:env-vars": "bash scripts/check-test-env-vars.sh",
    "verify:ui": "npx tsx scripts/verify-ui-rules.ts",
    "validate:session": "npx tsx scripts/validate-session.ts",
    "close:session": "npx tsx scripts/close-session.ts",
    "premortem:check": "npx tsx scripts/premortem-check.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:all": "pnpm run lint && pnpm run test:react-consistency && pnpm run test:env-vars && pnpm run verify:ui && pnpm run test",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.0.8",
    "tsx": "^4.22.3",
    "typescript-eslint": "^8.61.1"
  }
}
